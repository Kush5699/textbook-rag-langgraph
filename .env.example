# Required for real AI answers and semantic embeddings.
OPENAI_API_KEY=

# Change these only when needed. `hash` is for offline tests only.
EMBEDDING_PROVIDER=openai
CHAT_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
EMBEDDING_DIMENSIONS=1536

# Security: replace before any public deployment.
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000

# Services and storage.
DATABASE_URL=sqlite:///./data/app.db
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=textbook_chunks
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=75

# Retrieval tuning.
CHILD_CHUNK_TOKENS=260
PARENT_CHUNK_TOKENS=900
CHUNK_OVERLAP_TOKENS=45
RETRIEVAL_CANDIDATES=20
FINAL_CONTEXT_CHUNKS=4
MIN_EVIDENCE_SCORE=0.015
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
