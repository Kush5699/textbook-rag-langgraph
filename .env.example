# =============================================================================
# GSSTB Scholar - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- LLM Provider ---
GROQ_API_KEY=your_groq_api_key_here

# --- Authentication ---
JWT_SECRET=change-this-to-a-random-secret-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- Retrieval Tuning ---
DISTANCE_THRESHOLD=1.30
ENABLE_RERANKER=false
TOP_K_VECTOR=10
TOP_K_BM25=10

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Storage Paths ---
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_DB_PATH=./data/scholar.db
BM25_PERSIST_PATH=./data/bm25_index.pkl
PDF_STORAGE_DIR=./data/pdfs

# --- Server ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
HOST=0.0.0.0
PORT=8000

# --- Frontend (set in frontend/.env or as build arg) ---
VITE_API_URL=http://localhost:8000
